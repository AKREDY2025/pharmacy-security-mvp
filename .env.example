# ============================================================================
# SECURITY MVP ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_USER=security_mvp
DB_PASSWORD=change_this_to_a_secure_password
DB_NAME=security_mvp
DB_HOST=db
DB_PORT=5432

# Full PostgreSQL connection string (auto-generated)
# DATABASE_URL=postgresql://security_mvp:password@db:5432/security_mvp

# ============================================================================
# FASTAPI CONFIGURATION
# ============================================================================
SECRET_KEY=your-secret-key-change-in-production-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000

# ============================================================================
# NGINX CONFIGURATION (Production)
# ============================================================================
DOMAIN_NAME=yourdomain.com
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@pharmsecure.com

# ============================================================================
# SENTRY ERROR TRACKING (Optional)
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# ============================================================================
# EXTERNAL API INTEGRATIONS (Optional)
# ============================================================================
# Stripe Payment Processing
STRIPE_API_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio SMS Notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 (for file uploads/backups)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=pharmacy-security-mvp
AWS_REGION=us-east-1

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
ENVIRONMENT=production  # development, staging, production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_TO_FILE=True
LOG_FILE_PATH=/app/logs/security-mvp.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=10

# Enable monitoring
ENABLE_PROMETHEUS_METRICS=True
PROMETHEUS_PORT=9090

# ============================================================================
# BACKUP & DATABASE
# ============================================================================
# Automated backup configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily  # daily, weekly, monthly
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups/

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
ENABLE_2FA=True
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT_MINUTES=15
SESSION_TIMEOUT_MINUTES=60

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL_CHARS=True

# ============================================================================
# FRAUD DETECTION CONFIGURATION
# ============================================================================
# Fraud detection sensitivity (0.0-1.0)
FRAUD_SENSITIVITY=0.85

# Enable fraud alerts
ENABLE_FRAUD_ALERTS=True
FRAUD_ALERT_EMAIL=alerts@pharmsecure.com

# ============================================================================
# API RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=1000  # requests per minute
RATE_LIMIT_BY_IP=True

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ============================================================================
# DOCKER SPECIFIC
# ============================================================================
POSTGRES_INITDB_ARGS=-c max_connections=200 -c shared_buffers=256MB
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# ============================================================================
# TIMEZONE
# ============================================================================
TZ=Africa/Accra
